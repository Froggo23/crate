# ---- Supabase ----
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_REF=
SUPABASE_DB_PASSWORD=

# Transaction pooler (:6543) — serverless functions
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Session pooler (:5432) — migrations and long-running scripts
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- LLM / embeddings ----
# anthropic | openai. Omit to auto-detect from whichever key is present.
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_CHAT_MODEL=gpt-4o
# ANTHROPIC_API_KEY=
ANTHROPIC_CHAT_MODEL=claude-opus-5

# ---- Ingestion ----
# MusicBrainz requires a contactable User-Agent and will block you without one.
CRATE_USER_AGENT=CRATE/0.1 (+https://github.com/Froggo23/crate)
# Optional second corpus source; free key at https://devportal.jamendo.com
# JAMENDO_CLIENT_ID=
CRON_SECRET=
